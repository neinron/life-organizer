{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-organizer-feed",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "organizer.example.com", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "BOARD", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ]
}
